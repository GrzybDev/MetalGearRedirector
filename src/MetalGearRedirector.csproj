<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Title>MetalGearRedirector</Title>
    <Description>Redirects the manual links of the METAL GEAR &amp; METAL GEAR 2: Solid Snake launcher, by default to the Polish manuals on metalgear.grzyb.app.</Description>
    <Authors>GrzybDev</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The defaults of the mod's settings, overridden per build with -p:Name=value. -->
  <PropertyGroup>
    <ManualHost>metalgear.grzyb.app</ManualHost>
    <ManualLanguage>pl</ManualLanguage>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ManualHost" Value="$(ManualHost)" />
    <AssemblyMetadata Include="ManualLanguage" Value="$(ManualLanguage)" />
    <!-- MelonLoader reads the mod's name, version and the game it is for from these. -->
    <AssemblyAttribute Include="MelonLoader.MelonInfoAttribute">
      <_Parameter1>typeof(MetalGearRedirector.Core)</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>$(Title)</_Parameter2>
      <_Parameter3>$(Version)</_Parameter3>
      <_Parameter4>$(Authors)</_Parameter4>
    </AssemblyAttribute>
    <AssemblyAttribute Include="MelonLoader.MelonGameAttribute">
      <_Parameter1>KONAMI</_Parameter1>
      <_Parameter2>launcher</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="MetalGearRedirector.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MelonLoader and its Harmony come with the loader installed in the game; only the mod itself ships. -->
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build" Condition="'$(ModsFolder)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsFolder)" />
  </Target>
</Project>
